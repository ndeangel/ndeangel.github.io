{
  "name": "ndeangel.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "Source of https://ndeangel.github.io (Jekyll site on GitHub Pages). npm is only used to compile src/ into assets/.",
  "scripts": {
    "build:css": "sass --style=compressed --no-source-map src/styles/main.scss assets/css/main.css",
    "build:js": "terser src/js/app.js --compress --mangle --output assets/js/main.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "sass --watch --style=expanded --no-source-map src/styles/main.scss assets/css/main.css",
    "serve": "bundle exec jekyll serve --livereload"
  },
  "devDependencies": {
    "sass": "^1.89.0",
    "terser": "^5.39.0"
  },
  "license": "ISC"
}
