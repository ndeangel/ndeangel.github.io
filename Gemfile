source "https://rubygems.org"

# GitHub Pages builds the site with exactly this set of gems (https://pages.github.com/versions/),
# so a local build with it gives the same result as the published site.
# jekyll-sitemap (sitemap.xml) is part of it and is switched on in _config.yml.
gem "github-pages", group: :jekyll_plugins

# `jekyll serve` needs webrick on Ruby 3 and later.
gem "webrick", "~> 1.8"
